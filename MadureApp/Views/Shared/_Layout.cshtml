<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MADURE - @ViewBag.Title</title>

    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">


    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #8B4513; 
            --secondary-color: #D4AF37;
            --dark-color: #2C1810; 
            --light-color: #F5E6D3; 
        }

        body {
            font-family: 'Montserrat', sans-serif;
            color: #333;
            background-color: #f9f9f9;
            padding-top: 80px;
        }

        h1, h2, h3, h4 {
            font-family: 'Playfair Display', serif;
            font-weight: 600;
        }

        .navbar {
            background-color: var(--dark-color) !important;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        }

        .navbar-brand {
            color: var(--secondary-color) !important;
            font-weight: 700;
            font-size: 1.8rem;
            letter-spacing: 1px;
        }

        .nav-link {
            color: #fff !important;
            font-weight: 500;
            margin: 0 5px;
            transition: all 0.3s;
        }

            .nav-link:hover {
                color: var(--secondary-color) !important;
            }

        .hero-section {
            background: linear-gradient(rgba(44, 24, 16, 0.85), rgba(44, 24, 16, 0.9)), url('https://images.unsplash.com/photo-1578948856697-db91d246b7b1?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80');
            background-size: cover;
            background-position: center;
            color: white;
            padding: 100px 0;
            margin-bottom: 60px;
        }

        .product-card {
            background: white;
            border: none;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            transition: all 0.3s ease;
            height: 100%;
            overflow: hidden;
        }

            .product-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 15px 40px rgba(0,0,0,0.15);
            }

            .product-card .card-body {
                padding: 25px;
            }

        .product-title {
            color: var(--dark-color);
            font-size: 1.4rem;
            margin-bottom: 10px;
            font-weight: 600;
        }

        .product-price {
            color: var(--primary-color);
            font-size: 1.5rem;
            font-weight: 700;
        }

        .stock-badge {
            background-color: #e8f5e9;
            color: #2e7d32;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.9rem;
        }

        .btn-primary-custom {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            color: white;
            padding: 10px 25px;
            border-radius: 30px;
            font-weight: 600;
            transition: all 0.3s;
        }

            .btn-primary-custom:hover {
                background-color: var(--dark-color);
                border-color: var(--dark-color);
                transform: scale(1.05);
            }

        .recipes-section {
            background-color: var(--light-color);
            padding: 60px 0;
            margin-top: 80px;
        }

        .recipe-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
            height: 100%;
        }

        .recipe-title {
            color: var(--primary-color);
            border-left: 4px solid var(--secondary-color);
            padding-left: 15px;
            margin-bottom: 20px;
        }

        .footer {
            background-color: var(--dark-color);
            color: white;
            padding: 50px 0 30px;
            margin-top: 60px;
        }

            .footer h5 {
                color: var(--secondary-color);
                margin-bottom: 20px;
            }

            .footer a {
                color: #ccc;
                text-decoration: none;
                transition: color 0.3s;
            }

                .footer a:hover {
                    color: var(--secondary-color);
                }

        .copyright {
            border-top: 1px solid #444;
            padding-top: 20px;
            margin-top: 40px;
            text-align: center;
            color: #aaa;
        }

        /* Estilos para la tabla de administración */
        .admin-table {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }

            .admin-table th {
                background-color: var(--dark-color);
                color: white;
                border: none;
                padding: 15px;
            }

            .admin-table td {
                padding: 15px;
                vertical-align: middle;
            }

        .action-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin: 0 5px;
            transition: all 0.3s;
        }

        .action-edit {
            background-color: #e3f2fd;
            color: #1976d2;
        }

        .action-delete {
            background-color: #ffebee;
            color: #d32f2f;
        }

        .action-btn:hover {
            transform: scale(1.1);
        }


        html {
            scroll-behavior: smooth;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/Home/Index">
                <i class="fas fa-honey-pot me-2"></i>MADURE
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/Home/Index">
                            <i class="fas fa-home me-1"></i>Inicio
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Home/Admin">
                            <i class="fas fa-cogs me-1"></i>Administración
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#recetas">
                            <i class="fas fa-book me-1"></i>Recetas
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#contacto">
                            <i class="fas fa-envelope me-1"></i>Contacto
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Home/About">
                            <i class="fas fa-info-circle me-1"></i>Quiénes Somos
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Contenido principal -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer" id="contacto">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5><i class="fas fa-honey-pot me-2"></i>MADURE</h5>
                    <p class="mt-3">El auténtico sabor del ron con miel artesanal. Calidad y tradición desde 1995.</p>
                    <div class="mt-4">
                        <a href="#" class="me-3"><i class="fab fa-facebook fa-lg"></i></a>
                        <a href="#" class="me-3"><i class="fab fa-instagram fa-lg"></i></a>
                        <a href="#" class="me-3"><i class="fab fa-twitter fa-lg"></i></a>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <h5><i class="fas fa-link me-2"></i>Enlaces Rápidos</h5>
                    <ul class="list-unstyled mt-3">
                        <li class="mb-2"><a href="/Home/Index">Inicio</a></li>
                        <li class="mb-2"><a href="/Home/Admin">Administración de Productos</a></li>
                        <li class="mb-2"><a href="#recetas">Nuestras Recetas</a></li>
                        <li class="mb-2"><a href="/Home/About">Quiénes Somos</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-4">
                    <h5><i class="fas fa-envelope me-2"></i>Contáctenos</h5>
                    <ul class="list-unstyled mt-3">
                        <li class="mb-2"><i class="fas fa-map-marker-alt me-2"></i>Av. Principal 123, Ciudad</li>
                        <li class="mb-2"><i class="fas fa-phone me-2"></i>(123) 456-7890</li>
                        <li class="mb-2"><i class="fas fa-envelope me-2"></i>info@madure.com</li>
                        <li><i class="fas fa-clock me-2"></i>Lun-Vie: 9:00-18:00</li>
                    </ul>
                </div>
            </div>
            <div class="copyright">
                <p>&copy; @DateTime.Now.Year MADURE Honey Rum Premium. Todos los derechos reservados.</p>
                <p class="mb-0">Desarrollado por <strong>Edgar Rosario</strong></p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle (necesario para el navbar toggler) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>